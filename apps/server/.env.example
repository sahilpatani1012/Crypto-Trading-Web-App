# Backend configuration. Copy to .env for local overrides; every value has a
# sensible default, so the server runs with no .env at all.

# Injected by Render in production.
PORT=4000
HOST=0.0.0.0

# Fixing the seed makes the generated market reproducible across restarts, which
# is what lets tests assert on it and a demo replay the same price path.
MARKET_SEED=1337

# Comma-separated browser origins allowed to call REST and to open a WebSocket.
# "*" allows everything and is the default for local development.
# In production set this to the deployed frontend, e.g.
#   CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*
