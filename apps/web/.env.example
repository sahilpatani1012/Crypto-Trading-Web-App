# Frontend configuration.
#
# NEXT_PUBLIC_ is required: Next inlines those into the client bundle at BUILD
# time and strips everything else. Two consequences —
#   1. Never put a secret here. It ships to the browser.
#   2. Changing these needs a rebuild, not just a restart.

# Local development (the defaults, so no .env is needed to run locally).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Production. Note wss:// rather than ws:// — a browser on an HTTPS page refuses
# to open an insecure WebSocket, and the failure is quiet.
# NEXT_PUBLIC_API_URL=https://cta-server-xxxx.onrender.com
# NEXT_PUBLIC_WS_URL=wss://cta-server-xxxx.onrender.com/ws
